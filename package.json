{
  "name": "satb-master",
  "version": "3.0.0",
  "description": "离线优先的 SATB 四部和声学习与编辑软件",
  "author": "VoidState-1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "generate:soundfont": "node scripts/generate-default-soundfont.mjs",
    "generate:icon": "node scripts/generate-app-icon.mjs",
    "generate:installer-assets": "node scripts/generate-installer-assets.mjs",
    "generate:assets": "npm run generate:soundfont && npm run generate:icon && npm run generate:installer-assets",
    "generate:assets:mac": "npm run generate:soundfont && npm run generate:icon -- --mac",
    "e2e:desktop": "node scripts/e2e-desktop.mjs",
    "e2e:audit": "npm run build && node scripts/e2e-audit.mjs",
    "e2e:desktop:local": "npm run build && node scripts/e2e-desktop.mjs --local",
    "dev": "npm run build:electron && concurrently --kill-others-on-fail \"vite\" \"wait-on tcp:5173 && electron . --dev\"",
    "dev:tools": "npm run build:electron && concurrently --kill-others-on-fail \"vite\" \"wait-on tcp:5173 && electron . --dev --devtools\"",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "build:electron": "node scripts/clean-electron-output.mjs && tsc -p tsconfig.electron.json && vite build --config vite.preload.config.ts",
    "pack:win": "npm run generate:assets && npm run build && electron-builder --win dir --x64",
    "dist:win": "npm run generate:assets && npm run build && node scripts/build-windows-installer.mjs",
    "pack:mac": "npm run generate:assets:mac && npm run build && electron-builder --mac dir --publish never",
    "dist:mac": "npm run generate:assets:mac && npm run build && electron-builder --mac dmg --universal --publish never",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run --execArgv=--no-experimental-webstorage --exclude \"StandardCase/Pilot/**\"",
    "score": "node scripts/score.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "audit": "node scripts/audit.mjs",
    "preview": "vite preview",
    "start": "electron ."
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "lucide-react": "^1.26.0",
    "midi-file": "^1.2.4",
    "quickjs-emscripten-core": "0.32.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "spessasynth_lib": "^4.3.11",
    "vexflow": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "26.15.3",
    "jsdom": "^29.1.1",
    "spessasynth_core": "4.3.15",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.satbmaster.desktop",
    "productName": "SATB Master",
    "asar": true,
    "afterPack": "./scripts/prepare-macos-app.mjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "public/soundfonts",
        "to": "soundfonts",
        "filter": [
          "default.sf2",
          "default.sf2.sha256",
          "LICENSE-default-soundfont.txt",
          "README.md"
        ]
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.music",
      "icon": "build/icon-macos.png",
      "artifactName": "SATB-Master-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "SATB Master 工程",
            "CFBundleTypeRole": "Editor",
            "CFBundleTypeIconFile": "icon.icns",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": ["com.satbmaster.desktop.project"]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.satbmaster.desktop.project",
            "UTTypeDescription": "SATB Master 工程",
            "UTTypeConformsTo": ["public.json", "public.content"],
            "UTTypeIconFile": "icon.icns",
            "UTTypeTagSpecification": { "public.filename-extension": ["satb"] }
          }
        ]
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "SATB Master",
      "artifactName": "SATB-Master-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "shortcutName": "SATB Master",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/uninstaller-icon.ico",
      "installerHeader": "build/installer-header.bmp",
      "installerSidebar": "build/installer-sidebar.bmp",
      "uninstallerSidebar": "build/uninstaller-sidebar.bmp",
      "include": "build/installer.nsh",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "warningsAsErrors": true
    }
  }
}
